# ============================================================
# gcr-sync Configuration
# ============================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# ============================================================

# ── Google OAuth Credentials ────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Desktop application)
# 3. Enable Google Classroom API and Google Drive API
# 4. Copy Client ID and Client Secret below

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080

# ── Telegram Bot ────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot
# 2. Copy the bot token below
# 3. Send a message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Find your chat_id in the response

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=your-chat-id

# ── AI Summary (Optional) ──────────────────────────────────
# Set to true to enable Groq-powered AI digests
# Get your API key at: https://console.groq.com/keys

ENABLE_AI_SUMMARY=true
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Storage ─────────────────────────────────────────────────
# Where to save downloaded files and database

DATA_DIRECTORY=./subjects
DATABASE_PATH=./cache.db

# ── Logging ─────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_LEVEL=INFO
